# App
APP_URL=http://127.0.0.1:43123
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123
NEXT_PUBLIC_DEMO=1

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://127.0.0.1:43123
AUTH_TRUST_HOST=true

# Google login (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL
DATABASE_URL=postgresql://karm:karm@127.0.0.1:5432/karmkaro?schema=public

# Redis — used by BullMQ when set. The app falls back to an in-process cron.
REDIS_URL=redis://127.0.0.1:6379

# Email. Leave RESEND and SMTP empty to log messages and store them in EmailOutbox.
EMAIL_FROM=Karm Karo <work@karmkaro.dev>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Anthropic. Empty key uses the built-in parser and a local assistant.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_DAILY_LIMIT=40

# S3-compatible uploads (Cloudflare R2 or AWS S3). Empty uses ./storage/uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Web Push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:work@karmkaro.dev
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cron endpoint shared secret
CRON_SECRET=replace-with-a-long-random-string

# Sentry (optional). Errors are always logged as JSON.
SENTRY_DSN=
